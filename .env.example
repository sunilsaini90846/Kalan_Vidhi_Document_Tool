# No secrets are required. Optional limits (bytes / counts) override defaults in src/utils/limits.ts
VITE_MAX_FILE_MB=100
VITE_MAX_FILES=50
# Optional override of the public site origin (no path, no trailing slash), e.g. for a staging host.
# Leave unset for production: canonical URLs, og:url, JSON-LD, sitemap.xml and robots.txt default to
# BRAND.siteUrl (https://doctool.kalanvidhi.com) in src/config/brand.ts. An invalid value fails the build.
# VITE_SITE_URL=
